# Copy this file to .env yourself. Never commit .env or paste secret values into logs.
# Empty secrets deliberately prevent a normal Compose start. Existing values must not be reset.
LA_STACK_NAME=lawyer-assistant-v1
LA_DEMO_MODE=false
LA_HTTP_PORT=8080
LA_BOOTSTRAP_USERNAME=
# At least 16 characters for a new account; existing account passwords are preserved.
LA_BOOTSTRAP_PASSWORD=
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Store a separate protected copy: encrypted documents cannot be recovered without this key.
LA_ENCRYPTION_KEY=
# Use a long randomly generated URL-safe password (letters, digits, dash, underscore).
LA_POSTGRES_PASSWORD=
LA_DATABASE_URL=
LA_DATA_DIR=/data
LA_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# false is only for the loopback HTTP evaluation deployment. Require true behind HTTPS.
LA_COOKIE_SECURE=false
LA_GRAPH_URL=http://fuseki:3030
# Publication volume is mounted read-only into API and Fuseki; keys are operator-supplied.
LA_GRAPH_TRUST_DIRECTORY=./.data/graph-trust
# Set /graph-trust/reviewer.pem only after importing the independent reviewer's public key.
LA_GRAPH_TRUSTED_REVIEW_KEY=
LA_OPENSEARCH_URL=http://opensearch:9200
# Set only after an approved public index release is published; the baseline corpus is empty.
LA_SEARCH_RELEASE_ID=
# Isolated clamd service. Provision verified official signatures before startup.
LA_CLAMAV_HOST=scanner
LA_CLAMAV_PORT=3310
LA_SCANNER_DATABASE_DIR=./.data/clamav-signatures
LA_SCANNER_TIMEOUT_SECONDS=30
LA_SCANNER_MAX_SIGNATURE_AGE_DAYS=7
# At least 32 random characters; unique to the isolated extraction service.
LA_EXTRACTION_URL=http://extractor:8002
LA_EXTRACTION_TOKEN=
LA_GATEWAY_ENABLED=false
LA_GATEWAY_URL=http://gateway:8001
# Required before enabling the optional research profile. Independent of the provider key.
LA_GATEWAY_TOKEN=
LA_GATEWAY_ALLOWLIST=www.mevzuat.gov.tr,mevzuat.gov.tr,www.resmigazete.gov.tr,resmigazete.gov.tr

# User-reported tenant activation; no independent runtime verification has occurred.
# Vetted private IP literal, e.g. https://10.20.0.8:8080/v1; no DNS names/public IPs.
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_TENANT_ID=lawyer-assistant-v1
LLM_PROVIDER_ORG_ID=org-lawyer
LLM_PROVIDER_KEY_ID=lawyer-assistant-v1-primary
LLM_PROVIDER_MODEL=
LLM_PROVIDER_CONTEXT_LIMIT=8192
LLM_PROVIDER_IDENTITY_VERIFIED=false
# Only for an explicitly approved private/loopback route; never external inference.
LLM_PROVIDER_ALLOW_PLAIN_HTTP=false
# Separate deployment attestation: a local URL does not prevent engine cloud fallback.
LLM_PROVIDER_CLOUD_FALLBACK_DISABLED=false
# Docker Desktop native-engine relay: start with --profile native-provider.
# After independent identity/fallback checks, use http://172.30.240.2:8083/v1 above.
LLM_PROVIDER_NATIVE_HOST=host.docker.internal
# Optional explicit exception for a laptop reached through one HTTPS tunnel.
# The API base URL stays http://172.30.240.2:8083/v1; the relay pins the tunnel.
# Set URL to https://the-approved-host/v1 and APPROVED_HOST to that exact host.
# This transport uses the internet; it is not air-gapped. No wildcard approvals.
LLM_PROVIDER_TUNNEL_URL=
LLM_PROVIDER_TUNNEL_APPROVED=false
LLM_PROVIDER_TUNNEL_APPROVED_HOST=
