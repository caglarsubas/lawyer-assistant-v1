      },
      {
        "after": "\t// A direct content-addressed lookup must not inherit a symlink target\n\t// identity. Named-manifest symlinks retain their existing checked behavior.\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tblobsRoot, err := filepath.Abs(filepath.Join(envconfig.Models(), \"blobs\"))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\texpectedDigest := \"\"\n\tif filepath.Dir(absPath) == blobsRoot {\n\t\tbase := filepath.Base(absPath)\n\t\tif !info.Mode().IsRegular() || !blobFilenamePattern.MatchString(base) {\n\t\t\treturn nil, errors.New(\"invalid regular manifest blob\")\n\t\t}\n\t\texpectedDigest = strings.ToLower(strings.TrimPrefix(base, \"sha256-\"))\n\t}\n\n\ttarget, err := evalAbs(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tif info.Mode()&os.ModeSymlink != 0 {",
        "before": "\ttarget, err := evalAbs(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tif info.Mode()&os.ModeSymlink != 0 {"
      },
      {
        "after": "\treturn &unverifiedManifestFile{file: f, expectedDigest: expectedDigest}, nil",
        "before": "\treturn &unverifiedManifestFile{file: f}, nil"
      }
    ],
